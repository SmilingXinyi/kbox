# Optional local overrides (copy to `.env.local` — never commit secrets).

# Set to "true" to allow BiometricSimulator in non-DEV builds (preview sandboxes only).
# Production must leave this unset/false — the simulator uses fixed key material.
# VITE_ENABLE_BIOMETRIC_SIMULATOR=false

# Google Drive OAuth 2.0 Web client ID (Drive appDataFolder). Redirect URI must be:
#   {origin}{base}/?kbox_cloud_oauth=1
# Example local: http://localhost:5173/?kbox_cloud_oauth=1
# VITE_GOOGLE_DRIVE_CLIENT_ID=

# Microsoft identity platform (Entra) public SPA client ID. Redirect URI same as above.
# API permission: Files.ReadWrite.AppFolder, offline_access
# VITE_ONEDRIVE_CLIENT_ID=
