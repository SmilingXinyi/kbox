{
    "name": "kbox",
    "private": true,
    "version": "0.3.9",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "build:pages": "tsc -b && vite build --config vite.config.pages.ts && cp dist/index.html dist/404.html",
        "lint": "eslint .",
        "preview": "vite preview",
        "format": "prettier --write .",
        "commit": "cz",
        "commitlint": "commitlint --edit",
        "lint-staged": "lint-staged",
        "prepare": "node .husky/install.mjs",
        "cy:open": "cypress open --component",
        "cy:run": "cypress run --component --browser chrome",
        "test": "cypress run --component --browser chrome",
        "test:dual-sync": "node scripts/dual-browser-sync.mjs"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.3.2",
        "html5-qrcode": "^2.3.8",
        "lucide-react": "^1.24.0",
        "motion": "^12.42.2",
        "peerjs": "^1.5.5",
        "qrcode": "^1.5.4",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-router": "^8.2.0"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@eslint/js": "^10.0.1",
        "@rolldown/plugin-babel": "^0.2.3",
        "@types/babel__core": "^7.20.5",
        "@types/node": "^24.13.2",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "babel-plugin-react-compiler": "^1.0.0",
        "commitizen": "^4.3.2",
        "cypress": "^15.18.1",
        "cz-conventional-changelog": "^3.3.0",
        "eslint": "^10.6.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "lint-staged": "^15.5.2",
        "playwright": "^1.61.1",
        "prettier": "~3.5.3",
        "tailwindcss": "^4.3.2",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.62.0",
        "vite": "^8.1.1"
    },
    "config": {
        "commitizen": {
            "path": "cz-conventional-changelog"
        }
    }
}
